# --- Server & Security ---
PORT=5000
# 🔐 WAJIB: Ganti dengan string acak yang panjang (min. 32 karakter) dan simpan dengan aman.
JWT_SECRET="isi-dengan-string-acak-yang-panjang-dan-aman-untuk-jwt-minimal-32-karakter"
# Password awal akun superadmin (min. 8 karakter). Wajib diisi di production.
SUPERADMIN_PASSWORD="ganti-dengan-password-superadmin-yang-kuat"
# URL Frontend (bisa multi-origin dipisah koma: http://localhost:3000,http://localhost:5173)
# Request same-origin (frontend + API di domain yang sama) otomatis diizinkan.
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# --- Database (Prisma) ---
DATABASE_URL="postgresql://postgres:12345@localhost:5432/ai_recruitment?schema=public"

# --- Google Gemini AI (WAJIB UNTUK AI INTERVIEW, SCORING & CV SCREENING) ---
# Dapatkan API Key GRATIS di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="isi-dengan-gemini-api-key-anda"
# Model untuk live interview audio: default gemini-2.0-flash-exp
GEMINI_LIVE_MODEL="gemini-2.0-flash-exp"

# --- Google Drive Sync (Service Account) [OPSIONAL] ---
# Arahkan ke file JSON kredensial Google Service Account jika ingin backup CV ke GDrive
GDRIVE_SERVICE_ACCOUNT_JSON="your-service-account-key.json"
GDRIVE_FOLDER_ID="isi-dengan-id-folder-google-drive"

# --- Application Closing Date ---
# Format ISO 8601. Biarkan kosong jika tidak ingin menutup pendaftaran.
APPLICATION_CLOSE_DATE="2026-06-22T23:59:00+07:00"

# Opsional: Google OAuth client ID untuk login peserta
GOOGLE_CLIENT_ID=""

# --- Transactional Email (reset password, undangan, kredensial) ---
# Opsional. Tanpa konfigurasi, email ditulis ke uploads/mail-outbox untuk mode lokal.
RESEND_API_KEY=""
MAIL_FROM="Talenta+ <no-reply@talenta.id>"
# Alternatif: endpoint webhook generik (POST JSON {from,to,subject,html,text})
MAIL_WEBHOOK_URL=""
# Basis URL untuk tautan email (reset password / login)
APP_BASE_URL="http://localhost:5173"

# --- Judge0 Code Execution ---
# Tanpa JUDGE0_URL, live coding memakai simulator lokal.
JUDGE0_URL=""
JUDGE0_KEY=""
JUDGE0_HOST=""
JUDGE0_CPU_LIMIT="5"
JUDGE0_WALL_LIMIT="10"
JUDGE0_MEMORY_LIMIT="128000"
