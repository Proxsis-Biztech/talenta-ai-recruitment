# --- Server & Security ---
PORT=5000
# 🔐 WAJIB: Ganti dengan string acak yang panjang (min. 32 karakter) dan simpan dengan aman.
JWT_SECRET="isi-dengan-string-acak-yang-panjang-dan-aman-untuk-jwt-minimal-32-karakter"
# URL Frontend (bisa multi-origin dipisah koma: http://localhost:3000,http://localhost:5173)
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# --- Database (Prisma) ---
DATABASE_URL="file:./dev.db?_journal_mode=WAL"

# --- Google Gemini AI (WAJIB UNTUK AI INTERVIEW, SCORING & CV SCREENING) ---
# Dapatkan API Key GRATIS di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="isi-dengan-gemini-api-key-anda"
# Model untuk live interview audio: default gemini-2.0-flash-exp
GEMINI_LIVE_MODEL="gemini-2.0-flash-exp"

# --- Google Drive Sync (Service Account) [OPSIONAL] ---
# Arahkan ke file JSON kredensial Google Service Account jika ingin backup CV ke GDrive
GDRIVE_SERVICE_ACCOUNT_JSON="your-service-account-key.json"
GDRIVE_FOLDER_ID="isi-dengan-id-folder-google-drive"

# --- Application Closing Date ---
# Format ISO 8601. Biarkan kosong jika tidak ingin menutup pendaftaran.
APPLICATION_CLOSE_DATE="2026-06-22T23:59:00+07:00"
