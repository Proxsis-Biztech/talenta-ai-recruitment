generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id          String       @id @default(uuid())
  code        String       @unique
  name        String       @unique
  industry    String?
  createdAt   DateTime     @default(now())
  admins      Admin[]
  portalUsers PortalUser[]
  jobs        Job[]
}

model Admin {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String   // Hashed password
  role      String   @default("admin") // "superadmin" | "admin"
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

model Applicant {
  id             String       @id @default(uuid())
  fullName       String
  placeOfBirth   String
  dateOfBirth    DateTime
  phone          String
  email          String       @unique
  address        String
  gender         String       // "Pria" | "Wanita"
  education      String       // "SMA" | "D1" | "D2" | "D3" | "D4" | "S1"
  university     String?      // Nullable jika pendidikan == SMA
  major          String?      // Nullable jika pendidikan == SMA
  gpa            Float?       // Nullable jika pendidikan == SMA
  cvFileName             String       // Nama file CV yang disimpan
  cvMimeType             String       // Tipe MIME file untuk keamanan
  localCvPath            String?      // Path lokal sementara sebelum ke cloud
  syncStatus             String       @default("pending") // "pending" | "success" | "failed"
  certificateFileName    String?      // Nama file Ijazah/Sertifikat (Max 5MB)
  certificateMimeType    String?      // Tipe MIME file Ijazah/Sertifikat
  experiences            Experience[] // Relasi One-to-Many
  createdAt              DateTime     @default(now())
  interviewResult        String?      // Menyimpan ringkasan/skor wawancara
  interviewTranscript    String?      // Menyimpan transkrip lengkap
  interviewStatus        String       @default("not_started") // "not_started" | "in_progress" | "completed" | "scored"
  interviewScore         Int?         // Skor hasil penilaian AI setelah wawancara
  interviewSkillMatrix   String?      // JSON skill matrix dari AI scoring
  interviewPhaseScores   String?      // JSON: skor per-fase & per-pertanyaan dari AI
  proctorFlags           String?      // JSON: log pelanggaran integritas selama interview
  appliedPosition        String       @default("General")
  screeningStatus        String       @default("pending") // "pending" | "success" | "failed"
  screeningScore         Int?
  screeningSummary       String?
  jobId                  String?
  job                    Job?         @relation(fields: [jobId], references: [id], onDelete: SetNull)
}

model Experience {
  id            String    @id @default(uuid())
  applicantId   String
  applicant     Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  companyName   String
  position      String
  startDate     DateTime
  endDate       DateTime? // Nullable jika isCurrent == true
  isCurrent     Boolean   @default(false)
}

model Job {
  id                   String      @id @default(uuid())
  code                 String?     @unique // Program code used by the assessment portal (e.g. SE-402)
  title                String      @unique
  description          String      // Berisi jobdesk & requirements
  status               String      @default("active") // "active" | "inactive"
  interviewDuration    Int?        // Durasi wawancara dalam menit
  interviewPassingScore Int?       // Skor kelulusan (0-100) untuk passing threshold
  tenantId             String?
  tenant               Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdAt            DateTime    @default(now())
  applicants           Applicant[]
}

model PortalUser {
  id              String          @id @default(uuid())
  email           String          @unique
  username        String?         @unique
  password        String
  name            String
  role            String          @default("peserta") // "peserta" | "asesor" | "admin" | "superadmin"
  phone           String?
  companyId       String?
  companyName     String?
  tenantId        String?
  tenant          Tenant?         @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  assessmentId    String?
  assessmentTitle String?
  gradeLevel      String?
  specialization  String?
  nik             String?
  education       String?
  university      String?
  city            String?
  portfolioUrl    String?
  bio             String?
  candidateCode   String?         @unique
  employeeNumber  String?
  department      String?
  assessorName    String?
  interviewScheduledAt DateTime?
  interviewCalledAt   DateTime?
  interviewEnteredAt  DateTime?
  interviewCompletedAt DateTime?
  interviewStatus String          @default("not_started")
  interviewScore  Float?
  faceVerifiedAt  DateTime?
  deviceCheckCompletedAt DateTime?
  mustChangePassword Boolean      @default(false)
  profileCompleted   Boolean      @default(true)
  status          String          @default("Aktif") // "Aktif" | "Nonaktif"
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  examAttempts    ExamAttempt[]
  assessorScores  AssessorScore[]
}

model ExamAttempt {
  id                String   @id @default(uuid())
  userId            String
  user              PortalUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  programCode       String
  answers           String   @default("{}")
  markedDoubt       String   @default("{}")
  violations        String?
  score             Float?
  integrityScore    Int?
  autoGradedCount   Int?
  manualReviewCount Int?
  competencyScores  String?
  status            String   @default("in_progress") // "in_progress" | "submitted" | "graded"
  startedAt         DateTime @default(now())
  submittedAt       DateTime?
  updatedAt         DateTime @updatedAt

  @@unique([userId, programCode])
}

model ProgramAccessCode {
  code        String   @id
  programCode String
  maxUses     Int      @default(1000)
  uses        Int      @default(0)
  expiresAt   DateTime?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model ProgramQuestion {
  id            String  @id @default(uuid())
  programCode   String
  orderNo       Int
  type          String
  competency    String
  difficulty    String
  text          String
  codeSnippet   String?
  options       String?
  matchingPairs String?
  correctAnswer String?
  points        Int     @default(1)

  @@unique([programCode, orderNo])
}

model AssessorScore {
  id              String   @id @default(uuid())
  candidateCode   String
  candidateName   String
  programCode     String?
  programTitle    String
  assessorId      String
  assessor        PortalUser @relation(fields: [assessorId], references: [id], onDelete: Cascade)
  competencies    String   // JSON array
  interviewScore  Float
  compositeScore  Float
  recommendation  String
  notes           String?
  status          String   @default("draft") // "draft" | "signed"
  lhaHash         String?  @unique
  lhaNumber       String?
  signedAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([candidateCode, programTitle])
}

model MasterRecord {
  id        String   @id @default(uuid())
  scope     String   // "bank-soal" | "materi" | "program" | "company" | "ai-config"
  key       String
  value     String   // JSON payload
  updatedAt DateTime @updatedAt

  @@unique([scope, key])
}

model ProctoringReview {
  id            String   @id @default(uuid())
  candidateCode String
  eventId       String
  status        String   // "valid" | "false_positive"
  notes         String?
  reviewedBy    String
  updatedAt     DateTime @updatedAt

  @@unique([candidateCode, eventId])
}

model BillingTenant {
  id               String   @id
  code             String   @unique
  name             String
  industry         String
  contactPerson    String
  email            String
  creditBalance    Int
  availableQuota   Int
  usedQuota        Int
  ratePerCandidate Int      @default(45000)
  createdAt        DateTime @default(now())
  invoices         BillingInvoice[]
  transactions     BillingTransaction[]
}

model BillingInvoice {
  id              String   @id @default(uuid())
  invoiceNumber   String   @unique
  tenantId        String
  tenant          BillingTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  date            String
  dueDate         String
  requestedQuota  Int
  subtotal        Int
  ppn11           Int
  totalAmount     Int
  paymentMethod   String
  bankAccount     String
  status          String   @default("PENDING_APPROVAL")
  proofReceiptUrl String?
  approvedAt      DateTime?
  approvedBy      String?
  createdAt       DateTime @default(now())
}

model BillingTransaction {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         BillingTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batchName      String
  programTitle   String
  candidateCount Int
  deductedAmount Int
  timestamp      DateTime @default(now())
  type           String
  description    String
}

model AuditLog {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())
  actor     String
  action    String
  category  String
  ip        String
  target    String?
  details   String
  status    String

  @@index([timestamp])
}
